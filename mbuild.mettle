import "mbuild/api";

// raize_template: raize string templates: HTML/text renderer with escaping and sections
// Part of the raize web framework: https://github.com/Lex-Dellimere/RaizeWeb
fn project() {
  mb_package("raize_template", "0.1.0");
  mb_meta("description", "raize string templates: HTML/text renderer with escaping and sections");
  mb_meta("license", "Apache-2.0");
}

// Path dependencies on the other packages under raize_web/libs until the registry has them.
fn deps() {
  mb_dep_path("raize_core", "../core");
}
